# RETINA — Environment Variables Template
# Copy this file to .env and fill in real values. Never commit .env.

# =============================================================================
# OpenAI (required for GPT-4o zero-shot Stage 1 fallback)
# =============================================================================
OPENAI_API_KEY=sk-...

# =============================================================================
# Worker ML Configuration
# =============================================================================
# Directory holding per-category checkpoints named patchcore_{category}.ckpt
# (15 files, ~230 MB each). This is a DIRECTORY, not a single .pt file.
# Currently informational only: PatchCoreRegistry hardcodes ./checkpoints
# relative to the worker's working directory.
PATCHCORE_CHECKPOINT_PATH=./checkpoints
GPT4V_PRODUCT_TYPE=manufactured product

# =============================================================================
# Redis
# =============================================================================
# Required. docker-compose.yml passes this to redis-server --requirepass and
# fails fast if it is unset. Use a long random string.
REDIS_PASSWORD=change_me_strong_redis_password

# =============================================================================
# Connection Strings
# =============================================================================
# Must carry REDIS_PASSWORD now that Redis requires auth.
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# =============================================================================
# Frontend
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001
